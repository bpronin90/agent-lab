      "notes": "The SSH node does not fail on a non-zero exit code. A refusal from Claim Delivery stops the workflow here (false branch is intentionally unconnected).",
      "id": "calm-down-6"
    },
    {
      "parameters": {
        "resource": "message",
        "operation": "send",
        "sendTo": "={{ JSON.parse($json.stdout).to }}",
        "subject": "={{ JSON.parse($json.stdout).subject }}",
        "emailType": "html",
        "message": "={{ JSON.parse($json.stdout).html }}",
        "options": {}
      },
      "name": "Send Gmail",
      "type": "n8n-nodes-base.gmail",
      "typeVersion": 2.1,
      "position": [
        1540,
        0
      ],
      "retryOnFail": false,
      "maxTries": 1,
      "onError": "continueErrorOutput",
      "notes": "Attach the owner's Gmail credential in n8n after import. No credential is exported.",
      "id": "calm-down-7"
