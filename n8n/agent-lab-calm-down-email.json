        "command": "=\"$AGENT_LAB_CALM_DOWN_PYTHON\" \"$AGENT_LAB_CALM_DOWN_RUNNER\" ack --outcome sent --execution-id {{ JSON.parse($('Claim Delivery').first().json.stdout).execution_id }}"
      },
