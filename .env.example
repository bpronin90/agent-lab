# Copy to .env (git-ignored). Never commit real values.
AGENT_LAB_PROVIDER=mock
# AGENT_LAB_PROVIDER=gemini
# GEMINI_API_KEY=            # free-tier key from https://aistudio.google.com/apikey
AGENT_LAB_GEMINI_MODEL=gemini-2.5-flash
# AGENT_LAB_GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
AGENT_LAB_MAX_REQUESTS=6
AGENT_LAB_MAX_TOOL_CALLS=8
AGENT_LAB_MAX_OUTPUT_TOKENS=2048
AGENT_LAB_MAX_ATTEMPTS=3
AGENT_LAB_DEADLINE_SECONDS=120
